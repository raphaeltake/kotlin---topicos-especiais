<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Syncro.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="hintTextColor">@color/input_hint</item>
        <item name="android:textColorHint">@color/gray</item>
        <item name="startIconTint">@color/gray</item>
        <item name="endIconTint">@color/gray</item>
    </style>

    <!-- Itens do seletor de papel (Gerenciar membros). -->
    <style name="Widget.Syncro.SpinnerItem" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
