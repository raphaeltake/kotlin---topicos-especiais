<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Syncro" parent="Theme.Material3.Light.NoActionBar">
        <item name="syncroTextInputStyle">@style/Widget.Syncro.TextInput</item>
        <item name="colorPrimary">@color/blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_soft_strong</item>
        <item name="colorOnPrimaryContainer">@color/blue_dark</item>
        <item name="colorSecondary">@color/blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/blue_soft</item>
        <item name="colorOnSecondaryContainer">@color/blue_dark</item>
        <item name="colorTertiary">@color/blue</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/blue_soft</item>
        <item name="colorOnTertiaryContainer">@color/blue_dark</item>
        <item name="colorAccent">@color/blue</item>
        <item name="colorControlActivated">@color/blue</item>
        <item name="android:colorAccent">@color/blue</item>
        <item name="android:colorControlActivated">@color/blue</item>
        <item name="android:textColorHighlight">@color/blue_highlight</item>

        <!-- Superfícies, contornos e erros da interface moderna. -->
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/gray</item>
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/light_gray</item>
        <item name="colorOutline">@color/border_strong</item>
        <item name="colorOutlineVariant">@color/border</item>
        <item name="colorError">@color/status_red_text</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Syncro.Dialog</item>
        <!-- Evita que diálogos e menus recebam o tom azulado da elevação do Material 3. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.Syncro" parent="Base.Theme.Syncro" />

    <!-- Diálogos com cantos bem arredondados e fundo branco. -->
    <style name="ThemeOverlay.Syncro.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/Widget.Syncro.Dialog</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
    </style>

    <style name="Widget.Syncro.Dialog" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearance.Syncro.Dialog</item>
        <item name="backgroundTint">@color/white</item>
    </style>

    <style name="ShapeAppearance.Syncro.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
</resources>
