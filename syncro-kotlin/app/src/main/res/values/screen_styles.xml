<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mobile typography and controls based on the existing invite and create-team screens. -->

    <style
        name="Screen.Body"
        parent="">
        <item name="android:layout_width">match_parent</item>

        <item name="android:layout_height">wrap_content</item>

        <item name="android:textColor">@color/gray</item>

        <item name="android:textSize">14sp</item>

        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style
        name="Screen.Label"
        parent="Screen.Body">
        <item name="android:textColor">@color/black</item>

        <item name="android:textSize">16sp</item>

        <item name="android:textStyle">bold</item>
    </style>

    <style
        name="Screen.Section"
        parent="Screen.Label">
        <item name="android:textSize">18sp</item>
    </style>

    <style
        name="Screen.Title"
        parent="Screen.Label">
        <item name="android:textSize">22sp</item>
    </style>

    <style
        name="Screen.Badge"
        parent="Screen.Label">
        <item name="android:layout_width">wrap_content</item>

        <item name="android:textSize">12sp</item>

        <item name="android:background">@drawable/bg_badge</item>

        <item name="android:paddingHorizontal">12dp</item>

        <item name="android:paddingVertical">4dp</item>
    </style>

    <style
        name="Screen.Button.Primary"
        parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>

        <item name="android:layout_height">wrap_content</item>

        <item name="android:minHeight">52dp</item>

        <item name="android:insetTop">0dp</item>

        <item name="android:insetBottom">0dp</item>

        <item name="android:paddingVertical">12dp</item>

        <item name="android:textAllCaps">false</item>

        <item name="android:textColor">@color/white</item>

        <item name="android:textStyle">bold</item>

        <item name="backgroundTint">@color/blue</item>

        <item name="cornerRadius">8dp</item>

        <item name="iconTint">@color/white</item>

        <item name="iconGravity">textStart</item>

        <item name="iconSize">20dp</item>
    </style>

    <style
        name="Screen.Button.Outline"
        parent="Screen.Button.Primary">
        <item name="backgroundTint">@color/white</item>

        <item name="android:textColor">@color/blue</item>

        <item name="iconTint">@color/blue</item>

        <item name="strokeColor">@color/blue</item>

        <item name="strokeWidth">1dp</item>
    </style>

    <style
        name="Screen.Button.Danger"
        parent="Screen.Button.Primary">
        <item name="backgroundTint">@color/status_red</item>
    </style>

    <style
        name="Screen.Button.Text"
        parent="Screen.Button.Outline">
        <item name="backgroundTint">@android:color/transparent</item>

        <item name="strokeWidth">0dp</item>

        <item name="android:minHeight">48dp</item>

        <item name="android:textSize">12sp</item>
    </style>

    <style
        name="Screen.Icon"
        parent="">
        <item name="android:layout_width">48dp</item>

        <item name="android:layout_height">48dp</item>

        <item name="android:padding">12dp</item>

        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>

        <item name="tint">@color/blue</item>
    </style>
</resources>
