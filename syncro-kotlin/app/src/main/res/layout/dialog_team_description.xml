<?xml version="1.0" encoding="utf-8"?>
<!-- Mesmo padrão visual dos demais diálogos (fundo, título e botão). -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_light"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Screen.Title"
            android:layout_marginBottom="16dp"
            android:text="@string/screen_team_description" />

        <TextView
            android:id="@+id/tvDescription"
            style="@style/Screen.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="@style/Screen.Button.Primary"
            android:layout_marginTop="24dp"
            android:text="@string/screen_close" />
    </LinearLayout>
</ScrollView>
