<?xml version="1.0" encoding="utf-8"?>
<!-- Um registro do histórico (RF25): tarefa, quem fez a alteração, valores
     anterior e novo e a data. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvHistoryTask"
        style="@style/Screen.Label"
        tools:text="@string/screen_task_title" />

    <TextView
        android:id="@+id/tvHistoryAction"
        style="@style/Screen.Body"
        android:textColor="@color/black"
        tools:text="@string/history_task_created" />

    <TextView
        android:id="@+id/tvHistoryDetail"
        style="@style/Screen.Body"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvHistoryDate"
        style="@style/Screen.Body"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        tools:text="@string/screen_sample_date" />
</LinearLayout>
