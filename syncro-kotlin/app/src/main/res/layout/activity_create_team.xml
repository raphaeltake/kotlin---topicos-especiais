<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/createTeamRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical"
    tools:context=".CreateTeamActivity">

    <include
        android:id="@+id/createTeamHeader"
        layout="@layout/include_screen_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <ImageView
                style="@style/Screen.IconTile"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:padding="16dp"
                android:src="@drawable/ic_group_add" />

            <TextView
                android:id="@+id/tvCreateTeamTitle"
                style="@style/Screen.Title"
                android:layout_marginTop="20dp"
                android:text="@string/create_team_title" />

            <TextView
                style="@style/Screen.Subtitle"
                android:text="@string/create_team_subtitle" />

            <LinearLayout
                android:id="@+id/createTeamCard"
                style="@style/Screen.Card"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <br.com.fatec.syncro.ui.SyncroTextInput
                    android:id="@+id/teamNameInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="name"
                    android:hint="@string/team_name_label"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    app:startIconDrawable="@drawable/ic_group_small" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateTeam"
                    style="@style/Screen.Button.Primary"
                    android:layout_marginTop="20dp"
                    android:text="@string/create_team_button"
                    app:icon="@drawable/ic_plus" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
