<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <LinearLayout style="@style/Screen.TopBar">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Screen.IconButton"
            android:contentDescription="@string/screen_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Screen.TopBar.Title"
            android:text="@string/screen_notifications" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvNotificationsSubtitle"
                style="@style/Screen.Body"
                android:text="@string/screen_notifications_subtitle" />

            <!-- Convite pendente -->
            <LinearLayout
                android:id="@+id/notificationInviteCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_highlight"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Screen.IconTile"
                        android:src="@drawable/ic_group_add" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Screen.Overline"
                            android:text="@string/screen_notification_invite_label"
                            android:textColor="@color/blue"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvNotification5"
                            style="@style/Screen.Label"
                            android:layout_marginTop="4dp"
                            android:text="@string/screen_notification_4"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeclineInvite"
                        style="@style/Screen.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/screen_decline_invite" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAcceptInvite"
                        style="@style/Screen.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/screen_accept_invite" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvActivityLabel"
                style="@style/Screen.Overline"
                android:layout_marginTop="24dp"
                android:text="@string/screen_notifications_activity" />

            <!-- Nova tarefa -->
            <LinearLayout
                android:id="@+id/notificationCard1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_pressable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    style="@style/Screen.IconTile"
                    android:src="@drawable/ic_team_tasks" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNotification1"
                        style="@style/Screen.Label"
                        android:text="@string/screen_notification_0"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Screen.Body"
                        android:layout_marginTop="2dp"
                        android:text="@string/screen_notification_open"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- Novo membro -->
            <LinearLayout
                android:id="@+id/notificationCard2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_pressable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    style="@style/Screen.IconTile"
                    android:background="@drawable/bg_icon_tile_green"
                    android:src="@drawable/ic_person_add"
                    app:tint="@color/status_green_text" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNotification2"
                        style="@style/Screen.Label"
                        android:text="@string/screen_notification_1"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Screen.Body"
                        android:layout_marginTop="2dp"
                        android:text="@string/screen_notification_open"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- Pedido de entrada -->
            <LinearLayout
                android:id="@+id/notificationCard3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_pressable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    style="@style/Screen.IconTile"
                    android:background="@drawable/bg_icon_tile_yellow"
                    android:src="@drawable/ic_team_members"
                    app:tint="@color/status_yellow_text" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNotification3"
                        style="@style/Screen.Label"
                        android:text="@string/screen_notification_2"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Screen.Body"
                        android:layout_marginTop="2dp"
                        android:text="@string/screen_notification_open"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- Convite aceito -->
            <LinearLayout
                android:id="@+id/notificationCard4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_pressable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    style="@style/Screen.IconTile"
                    android:background="@drawable/bg_icon_tile_green"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/status_green_text" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNotification4"
                        style="@style/Screen.Label"
                        android:text="@string/screen_notification_3"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Screen.Body"
                        android:layout_marginTop="2dp"
                        android:text="@string/screen_notification_open"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
