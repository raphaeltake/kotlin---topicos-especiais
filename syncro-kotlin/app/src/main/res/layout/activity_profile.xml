<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <include layout="@layout/include_screen_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="28dp">

            <TextView
                style="@style/Screen.Title"
                android:text="@string/profile_title" />

            <TextView
                style="@style/Screen.Subtitle"
                android:text="@string/profile_subtitle" />

            <!-- Resumo da conta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_hero_gradient"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:outlineSpotShadowColor="@color/blue"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvProfileAvatar"
                    style="@style/Screen.Avatar"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_icon_tile_glass"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="AS" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="Ana Souza" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/white_85"
                        android:textSize="14sp"
                        tools:text="ana@email.com" />
                </LinearLayout>
            </LinearLayout>

            <!-- Dados pessoais -->
            <LinearLayout
                style="@style/Screen.Card"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Screen.Overline"
                    android:layout_marginBottom="4dp"
                    android:text="@string/profile_section_personal" />

                <br.com.fatec.syncro.ui.SyncroTextInput
                    android:id="@+id/profileNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:autofillHints="name"
                    android:hint="@string/name_label"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    app:startIconDrawable="@drawable/ic_badge" />

                <br.com.fatec.syncro.ui.SyncroTextInput
                    android:id="@+id/profileEmailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:autofillHints="emailAddress"
                    android:hint="@string/email_input_label"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    app:startIconDrawable="@drawable/ic_mail" />
            </LinearLayout>

            <!-- Segurança -->
            <LinearLayout
                style="@style/Screen.Card"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Screen.Overline"
                    android:text="@string/profile_section_security" />

                <TextView
                    style="@style/Screen.Body"
                    android:layout_marginTop="6dp"
                    android:text="@string/profile_password_help" />

                <br.com.fatec.syncro.ui.SyncroTextInput
                    android:id="@+id/profilePasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:autofillHints="newPassword"
                    android:hint="@string/profile_new_password_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    app:endIconContentDescription="@string/toggle_password_visibility"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_lock" />

                <br.com.fatec.syncro.ui.SyncroTextInput
                    android:id="@+id/profileConfirmPasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:autofillHints="newPassword"
                    android:hint="@string/profile_confirm_password_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    app:endIconContentDescription="@string/toggle_password_visibility"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_lock" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProfile"
                style="@style/Screen.Button.Primary"
                android:layout_marginTop="24dp"
                android:text="@string/save_changes" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
