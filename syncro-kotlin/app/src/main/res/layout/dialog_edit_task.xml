<?xml version="1.0" encoding="utf-8"?>
<!-- Formulário: screen_edit_task -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        style="@style/Screen.Dialog.Content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                style="@style/Screen.IconTile"
                android:src="@drawable/ic_edit" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/Screen.Dialog.Title"
                    android:text="@string/screen_edit_task" />

                <TextView
                    style="@style/Screen.Body"
                    android:layout_marginTop="2dp"
                    android:text="@string/screen_edit_task_subtitle"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Screen.Field"
            android:hint="@string/screen_task_title_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTaskTitle"
                style="@style/Screen.Field.Edit"
                tools:text="@string/screen_sample_task_title_label" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Screen.Field"
            android:hint="@string/screen_responsibles_label"
            app:startIconDrawable="@drawable/ic_person_small">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etResponsibles"
                style="@style/Screen.Field.Edit"
                tools:text="@string/screen_sample_responsibles_label" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Screen.Field"
            android:hint="@string/screen_due_date_label"
            app:startIconDrawable="@drawable/ic_calendar_small">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDueDate"
                style="@style/Screen.Field.Edit"
                android:inputType="date"
                tools:text="@string/screen_sample_due_date_label" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Screen.Field"
            android:hint="@string/screen_description_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescription"
                style="@style/Screen.Field.Edit.Multiline"
                tools:text="@string/screen_sample_description_label" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout style="@style/Screen.Dialog.Buttons">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Screen.Dialog.Button.Cancel"
                android:text="@string/screen_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveTask"
                style="@style/Screen.Dialog.Button.Confirm"
                android:text="@string/screen_action_btnsavetask" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
