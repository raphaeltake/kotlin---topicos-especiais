<?xml version="1.0" encoding="utf-8"?>
<!-- Confirmação de remoção concluída. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        style="@style/Screen.Dialog.Content"
        android:gravity="center_horizontal">

        <ImageView
            style="@style/Screen.Dialog.Icon"
            android:background="@drawable/bg_icon_circle_green"
            android:src="@drawable/ic_check"
            app:tint="@color/status_green_text" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Screen.Dialog.Title"
            android:gravity="center"
            android:text="@string/screen_member_removed" />

        <TextView
            style="@style/Screen.Dialog.Message"
            android:gravity="center"
            android:text="@string/screen_member_removed_message" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOk"
            style="@style/Screen.Button.Primary"
            android:layout_marginTop="28dp"
            android:text="@string/screen_ok" />
    </LinearLayout>
</ScrollView>
