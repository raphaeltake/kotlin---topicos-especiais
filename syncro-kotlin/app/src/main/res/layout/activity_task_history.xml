<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <LinearLayout style="@style/Screen.TopBar">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Screen.IconButton"
            android:contentDescription="@string/screen_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tvTasksTitle"
            style="@style/Screen.TopBar.Title"
            android:text="@string/screen_task_history" />

        <ImageButton
            android:id="@+id/btnNotifications"
            style="@style/Screen.IconButton"
            android:contentDescription="@string/screen_notifications"
            android:src="@drawable/ic_notifications" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/historySubtitleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_card_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    style="@style/Screen.IconTile"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:background="@drawable/bg_icon_tile_green"
                    android:src="@drawable/ic_done_all"
                    app:tint="@color/status_green_text" />

                <TextView
                    style="@style/Screen.Body"
                    android:layout_width="0dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/screen_task_history_subtitle" />
            </LinearLayout>

            <!-- Modelo substituído pela lista de tarefas finalizadas. -->
            <include
                android:id="@+id/taskItem0"
                layout="@layout/item_flow_task" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
