<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/joinTeamRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical"
    tools:context=".WorkspaceActivity">

    <include
        android:id="@+id/joinTeamHeader"
        layout="@layout/include_screen_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <ImageView
                style="@style/Screen.IconTile"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:padding="16dp"
                android:background="@drawable/bg_icon_tile_blue"
                android:src="@drawable/ic_key" />

            <TextView
                android:id="@+id/tvJoinTeamTitle"
                style="@style/Screen.Title"
                android:layout_marginTop="20dp"
                android:text="@string/screen_join_team" />

            <TextView
                style="@style/Screen.Subtitle"
                android:text="@string/screen_join_team_subtitle" />

            <LinearLayout
                android:id="@+id/joinTeamCard"
                style="@style/Screen.Card"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <br.com.fatec.syncro.ui.SyncroTextInput
                    android:id="@+id/teamCodeInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/screen_team_code"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textVisiblePassword"
                    app:startIconDrawable="@drawable/ic_key" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnJoinTeam"
                    style="@style/Screen.Button.Primary"
                    android:layout_marginTop="20dp"
                    android:text="@string/screen_join"
                    app:icon="@drawable/ic_enter_team" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
