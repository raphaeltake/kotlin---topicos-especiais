<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/taskDetailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    tools:context=".TaskDetailsActivity">

    <LinearLayout
        android:id="@+id/topBar"
        style="@style/Screen.TopBar"
        android:layout_width="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Screen.IconButton"
            android:contentDescription="@string/screen_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/Screen.TopBar.Title"
            android:gravity="center"
            android:text="@string/screen_task_details" />

        <ImageButton
            android:id="@+id/btnNotifications"
            style="@style/Screen.IconButton"
            android:contentDescription="@string/screen_notifications"
            android:src="@drawable/ic_notifications" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/footerLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <!-- Cabeçalho da tarefa -->
            <LinearLayout
                style="@style/Screen.Card"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStatusBadge"
                        style="@style/Screen.Badge"
                        tools:text="Pendente" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btnEditTask"
                        style="@style/Screen.IconButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="11dp"
                        android:contentDescription="@string/screen_edit_task"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/blue" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTaskTitle"
                    style="@style/Screen.Title"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textSize="22sp"
                    tools:text="Atualizar documentação" />

                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/light_gray"
                    android:importantForAccessibility="no" />

                <!-- Prazo -->
                <LinearLayout
                    android:id="@+id/dateLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Screen.IconTile"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_event" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/screen_due_date"
                            android:textColor="@color/gray"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDueDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            tools:text="05/10/2026" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Responsáveis -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Screen.IconTile"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_team_members" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/screen_responsibles"
                            android:textColor="@color/gray"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvResponsibles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="2"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            tools:text="Diego Alves" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Descrição -->
            <LinearLayout
                style="@style/Screen.Card"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Screen.Overline"
                    android:text="@string/screen_description" />

                <TextView
                    android:id="@+id/tvDescription"
                    style="@style/Screen.Body"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    tools:text="@string/screen_description_sample" />
            </LinearLayout>

            <!-- Comentários -->
            <LinearLayout
                style="@style/Screen.Card"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Screen.Overline"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/screen_comments" />

                    <LinearLayout
                        android:id="@+id/btnComment"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_pill_button_soft"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_plus"
                            app:tint="@color/blue_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/screen_comment"
                            android:textColor="@color/blue_dark"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Modelo substituído pela lista de comentários. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCommenterName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_member_name" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Rodapé com as ações da tarefa -->
    <LinearLayout
        android:id="@+id/footerLayout"
        style="@style/Screen.Footer"
        android:layout_width="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnDeleteTask"
            android:layout_width="@dimen/button_height"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_button_danger_soft"
            android:contentDescription="@string/screen_delete_task"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete"
            app:tint="@color/status_red_text" />

        <LinearLayout
            android:id="@+id/btnTaskAction"
            style="@style/Screen.ActionRow"
            android:layout_width="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/ivTaskActionIcon"
                style="@style/Screen.ActionRow.Icon"
                android:src="@drawable/ic_play" />

            <TextView
                android:id="@+id/tvTaskActionLabel"
                style="@style/Screen.ActionRow.Label"
                android:text="@string/screen_start_task" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
