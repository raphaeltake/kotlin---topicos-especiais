<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/teamDetailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    tools:context=".TeamDetailsActivity">

    <LinearLayout
        android:id="@+id/topBar"
        style="@style/Screen.TopBar"
        android:layout_width="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Screen.IconButton"
            android:contentDescription="@string/screen_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/Screen.TopBar.Title"
            android:gravity="center"
            android:text="@string/screen_team_details" />

        <ImageButton
            android:id="@+id/btnNotificationsTop"
            style="@style/Screen.IconButton"
            android:contentDescription="@string/screen_notifications"
            android:src="@drawable/ic_notifications" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/footerButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <!-- Cabeçalho da equipe -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_gradient"
                android:elevation="4dp"
                android:outlineSpotShadowColor="@color/blue"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvMemberCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_glass"
                    android:drawableStart="@drawable/ic_group_small"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/white"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/btnEditTeam"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/btnEditTeam"
                    tools:text="5 membros" />

                <ImageButton
                    android:id="@+id/btnEditTeam"
                    style="@style/Screen.IconButton.Glass"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="11dp"
                    android:contentDescription="@string/screen_edit_team"
                    android:src="@drawable/ic_edit"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTeamName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:ellipsize="end"
                    android:letterSpacing="-0.02"
                    android:maxLines="2"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btnEditTeam"
                    tools:text="Produto Syncro" />

                <TextView
                    android:id="@+id/tvTeamDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/screen_team_description"
                    android:textColor="@color/white_85"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTeamName" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Abas segmentadas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_segment_track"
                android:orientation="horizontal"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/tasksTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_selected"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTasksTabLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_tasks"
                        android:textColor="@color/blue"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTasksTabCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_counter"
                        android:gravity="center"
                        android:minWidth="24dp"
                        android:minHeight="22dp"
                        android:paddingHorizontal="7dp"
                        android:textColor="@color/blue"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="4" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/membersTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMembersTabLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_members"
                        android:textColor="@color/gray"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvMembersTabCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_counter"
                        android:gravity="center"
                        android:minWidth="24dp"
                        android:minHeight="22dp"
                        android:paddingHorizontal="7dp"
                        android:textColor="@color/gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="5" />
                </LinearLayout>
            </LinearLayout>

            <!-- Título da seção -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTeamSectionTitle"
                    style="@style/Screen.Section"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/screen_tasks" />

                <ImageButton
                    android:id="@+id/btnTaskHistory"
                    style="@style/Screen.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:contentDescription="@string/screen_task_history"
                    android:src="@drawable/ic_history" />
            </LinearLayout>

            <!-- Adicionar tarefa -->
            <LinearLayout
                android:id="@+id/btnAddTask"
                style="@style/Screen.ActionRow"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_add_dashed">

                <ImageView
                    style="@style/Screen.ActionRow.Icon"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/blue" />

                <TextView
                    style="@style/Screen.ActionRow.Label"
                    android:text="@string/screen_add_task"
                    android:textColor="@color/blue" />
            </LinearLayout>

            <!-- Modelo substituído pela lista de tarefas. -->
            <include
                android:id="@+id/taskItem1"
                layout="@layout/item_flow_task" />

            <LinearLayout
                android:id="@+id/membersPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/btnManageMembers"
                    style="@style/Screen.ActionRow"
                    android:background="@drawable/bg_button_soft">

                    <ImageView
                        style="@style/Screen.ActionRow.Icon"
                        android:src="@drawable/ic_team_members"
                        app:tint="@color/blue_dark" />

                    <TextView
                        style="@style/Screen.ActionRow.Label"
                        android:text="@string/screen_manage_members"
                        android:textColor="@color/blue_dark" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/membersList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Rodapé -->
    <LinearLayout
        android:id="@+id/footerButton"
        style="@style/Screen.Footer"
        android:layout_width="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/btnLeaveTeam"
            style="@style/Screen.ActionRow"
            android:background="@drawable/bg_button_danger_soft">

            <ImageView
                style="@style/Screen.ActionRow.Icon"
                android:src="@drawable/ic_logout"
                app:tint="@color/status_red_text" />

            <TextView
                style="@style/Screen.ActionRow.Label"
                android:text="@string/screen_leave_team"
                android:textColor="@color/status_red_text" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
