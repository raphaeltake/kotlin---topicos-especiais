<?xml version="1.0" encoding="utf-8"?>
<!-- Barra superior compartilhada: voltar à esquerda e notificações à direita. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Screen.TopBar">

    <ImageButton
        android:id="@+id/btnBack"
        style="@style/Screen.IconButton"
        android:contentDescription="@string/screen_back"
        android:src="@drawable/ic_arrow_back" />

    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/btnNotifications"
        style="@style/Screen.IconButton"
        android:contentDescription="@string/screen_notifications"
        android:src="@drawable/ic_notifications" />
</LinearLayout>
