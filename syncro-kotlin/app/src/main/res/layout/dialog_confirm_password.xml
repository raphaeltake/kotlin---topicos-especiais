<?xml version="1.0" encoding="utf-8"?>
<!-- Confirmação da senha atual antes de trocar e-mail ou senha no perfil -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        style="@style/Screen.Dialog.Content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                style="@style/Screen.IconTile"
                android:src="@drawable/ic_lock" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Screen.Dialog.Title"
                    android:text="@string/profile_confirm_identity_title" />

                <TextView
                    style="@style/Screen.Body"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_confirm_identity_subtitle"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Screen.Field"
            android:hint="@string/profile_current_password_hint"
            app:endIconContentDescription="@string/toggle_password_visibility"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCurrentPassword"
                style="@style/Screen.Field.Edit"
                android:autofillHints="password"
                android:imeOptions="actionDone"
                android:importantForAutofill="yes"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout style="@style/Screen.Dialog.Buttons">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Screen.Dialog.Button.Cancel"
                android:text="@string/screen_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmPassword"
                style="@style/Screen.Dialog.Button.Confirm"
                android:text="@string/profile_confirm_identity_button" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
