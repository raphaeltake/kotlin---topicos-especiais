<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvManagedMemberAvatar"
            style="@style/Screen.Avatar"
            tools:text="AS" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvManagedMemberName"
                style="@style/Screen.Label"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Ana Souza" />

            <TextView
                android:id="@+id/tvManagedMemberRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_chip_blue"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/blue_dark"
                android:textSize="12sp"
                tools:text="Papel: Criador(a)" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnRemoveManagedMember"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_button_danger"
            android:contentDescription="@string/screen_remove_member"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete"
            app:tint="@color/status_red_text" />
    </LinearLayout>

    <Spinner
        android:id="@+id/spinnerManagedMemberRole"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_spinner"
        android:contentDescription="@string/screen_role_prompt"
        android:dropDownVerticalOffset="52dp"
        android:paddingStart="4dp"
        android:paddingEnd="40dp"
        android:popupBackground="@drawable/bg_popup"
        android:prompt="@string/screen_role_prompt"
        android:spinnerMode="dropdown" />
</LinearLayout>
