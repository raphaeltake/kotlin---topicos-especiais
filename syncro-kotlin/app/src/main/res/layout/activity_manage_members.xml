<?xml version="1.0" encoding="utf-8"?>
<!-- Referência: 15 - Manter membros.png. Paleta e componentes dos layouts existentes. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">
    <include
        layout="@layout/include_screen_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/Screen.Title"
                    android:text="@string/screen_members"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddMember"
                    style="@style/Screen.Button.Primary"
                    android:text="@string/screen_add_member"
                    app:icon="@drawable/ic_person_add" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="0dp"
                    android:layout_marginTop="12dp"
                    android:paddingVertical="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvMemberName0"
                            style="@style/Screen.Label"
                            android:text="@string/screen_member_name"
                            android:layout_width="0dp"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/btnRemoveMember0"
                            style="@style/Screen.Icon"
                            android:src="@drawable/ic_delete"
                            android:contentDescription="@string/screen_remove_member" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMemberRole0"
                        style="@style/Screen.Body"
                        android:text="@string/screen_role_0"
                        android:layout_marginTop="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/light_gray"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="0dp"
                    android:layout_marginTop="12dp"
                    android:paddingVertical="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvMemberName1"
                            style="@style/Screen.Label"
                            android:text="@string/screen_member_name"
                            android:layout_width="0dp"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/btnRemoveMember1"
                            style="@style/Screen.Icon"
                            android:src="@drawable/ic_delete"
                            android:contentDescription="@string/screen_remove_member" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinnerMemberRole1"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:entries="@array/screen_admin_roles"
                        android:prompt="@string/screen_role_prompt"
                        android:contentDescription="@string/screen_role_prompt" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/light_gray"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="0dp"
                    android:layout_marginTop="12dp"
                    android:paddingVertical="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvMemberName2"
                            style="@style/Screen.Label"
                            android:text="@string/screen_member_name"
                            android:layout_width="0dp"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/btnRemoveMember2"
                            style="@style/Screen.Icon"
                            android:src="@drawable/ic_delete"
                            android:contentDescription="@string/screen_remove_member" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinnerMemberRole2"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:entries="@array/screen_member_roles"
                        android:prompt="@string/screen_role_prompt"
                        android:contentDescription="@string/screen_role_prompt" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/light_gray"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteTeam"
            style="@style/Screen.Button.Outline"
            android:text="@string/screen_delete_team"
            app:icon="@drawable/ic_delete" />
    </LinearLayout>
</LinearLayout>
