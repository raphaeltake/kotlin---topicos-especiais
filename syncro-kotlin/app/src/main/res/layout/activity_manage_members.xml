<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <include layout="@layout/include_screen_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <!-- Os cartões dos membros são inseridos depois do botão "Adicionar membro". -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/Screen.Title"
                android:text="@string/screen_members" />

            <TextView
                style="@style/Screen.Subtitle"
                android:text="@string/screen_members_subtitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddMember"
                style="@style/Screen.Button.Tonal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:text="@string/screen_add_member"
                app:icon="@drawable/ic_person_add" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        style="@style/Screen.Footer"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteTeam"
            style="@style/Screen.Button.DangerTonal"
            android:text="@string/screen_delete_team"
            app:icon="@drawable/ic_delete" />
    </LinearLayout>
</LinearLayout>
