<?xml version="1.0" encoding="utf-8"?>
<!-- Formulário: editar equipe -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        style="@style/Screen.Dialog.Content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                style="@style/Screen.IconTile"
                android:src="@drawable/ic_group_small" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/Screen.Dialog.Title"
                    android:text="@string/screen_edit_team" />

                <TextView
                    style="@style/Screen.Body"
                    android:layout_marginTop="2dp"
                    android:text="@string/screen_edit_team_subtitle"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Screen.Field"
            android:hint="@string/screen_team_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTeamName"
                style="@style/Screen.Field.Edit"
                tools:text="@string/screen_sample_team_name" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Screen.Field"
            android:hint="@string/screen_team_description">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTeamDescription"
                style="@style/Screen.Field.Edit.Multiline"
                tools:text="@string/screen_sample_team_description" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout style="@style/Screen.Dialog.Buttons">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Screen.Dialog.Button.Cancel"
                android:text="@string/screen_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveTeam"
                style="@style/Screen.Dialog.Button.Confirm"
                android:text="@string/screen_action_btnsaveteam" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
