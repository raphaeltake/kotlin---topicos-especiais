<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inviteTeamRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    tools:context=".InviteTeamActivity">

    <include
        android:id="@+id/topBar"
        layout="@layout/include_screen_toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/inviteContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/screen_padding"
        app:layout_constraintBottom_toTopOf="@+id/footerLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Screen.Title"
            android:layout_width="0dp"
            android:text="@string/invite_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            style="@style/Screen.Subtitle"
            android:layout_width="0dp"
            android:text="@string/invite_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- Código da equipe -->
        <LinearLayout
            android:id="@+id/teamCodeSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_hero_gradient"
            android:elevation="4dp"
            android:orientation="vertical"
            android:outlineSpotShadowColor="@color/blue"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="14dp"
            android:paddingBottom="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <TextView
                style="@style/Screen.Overline"
                android:text="@string/screen_team_code"
                android:textColor="@color/white_85" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTeamCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:textColor="@color/white"
                    android:textIsSelectable="true"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="12hg37f9d9" />

                <ImageButton
                    android:id="@+id/btnCopyTeamCode"
                    style="@style/Screen.IconButton.Glass"
                    android:contentDescription="@string/copy_team_code"
                    android:src="@drawable/ic_copy" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/invite_code_hint"
                android:textColor="@color/white_85"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Convite por e-mail -->
        <TextView
            android:id="@+id/tvEmailLabel"
            style="@style/Screen.Label"
            android:layout_width="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/invite_by_email"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/teamCodeSection" />

        <br.com.fatec.syncro.ui.SyncroTextInput
            android:id="@+id/emailInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:autofillHints="emailAddress"
            android:hint="@string/email_hint"
            android:imeOptions="actionDone"
            android:inputType="textEmailAddress"
            app:layout_constraintEnd_toStartOf="@id/btnAddEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvEmailLabel"
            app:startIconDrawable="@drawable/ic_mail" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddEmail"
            style="@style/Screen.Button.Primary"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/add_email"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_plus"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:layout_constraintBottom_toBottomOf="@id/emailInputLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/emailInputLayout" />

        <TextView
            android:id="@+id/tvListLabel"
            style="@style/Screen.Overline"
            android:layout_marginTop="20dp"
            android:text="@string/invite_list_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emailInputLayout" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/emailListScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvListLabel">

            <LinearLayout
                android:id="@+id/llEmailList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/footerLayout"
        style="@style/Screen.Footer"
        android:layout_width="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/btnInvite"
            style="@style/Screen.ActionRow">

            <ImageView
                style="@style/Screen.ActionRow.Icon"
                android:src="@drawable/ic_person_add" />

            <TextView
                android:id="@+id/tvInviteAction"
                style="@style/Screen.ActionRow.Label"
                android:text="@string/invite_button" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
