<?xml version="1.0" encoding="utf-8"?>
<!-- Uma notificação da lista (UC17): conteúdo, data, indicação de não lida e,
     para convites pendentes, as ações de aceitar ou recusar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_card_pressable"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivNotificationIcon"
            style="@style/Screen.IconTile"
            android:src="@drawable/ic_notifications" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNotificationText"
                style="@style/Screen.Label"
                android:textSize="15sp"
                tools:text="@string/screen_notification_4" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNotificationDate"
                    style="@style/Screen.Body"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    tools:text="@string/screen_sample_date" />

                <TextView
                    android:id="@+id/tvNotificationUnread"
                    style="@style/Screen.Badge"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/blue_soft_strong"
                    android:text="@string/notification_unread"
                    android:textColor="@color/blue_dark" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNotificationState"
                style="@style/Screen.Body"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notificationActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeclineNotification"
            style="@style/Screen.Button.Outline"
            android:layout_width="0dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/screen_decline_invite" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcceptNotification"
            style="@style/Screen.Button.Primary"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/screen_accept_invite" />
    </LinearLayout>
</LinearLayout>
