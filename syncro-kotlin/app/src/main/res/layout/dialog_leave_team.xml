<?xml version="1.0" encoding="utf-8"?>
<!-- Confirmação: screen_confirm_leave_team -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        style="@style/Screen.Dialog.Content"
        android:gravity="center_horizontal">

        <ImageView
            style="@style/Screen.Dialog.Icon"
            android:src="@drawable/ic_logout" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Screen.Dialog.Title"
            android:gravity="center"
            android:text="@string/screen_confirm_leave_team" />

        <TextView
            style="@style/Screen.Dialog.Message"
            android:gravity="center"
            android:text="@string/screen_confirm_leave_team_message" />

        <LinearLayout style="@style/Screen.Dialog.Buttons">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Screen.Dialog.Button.Cancel"
                android:text="@string/screen_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmLeaveTeam"
                style="@style/Screen.Dialog.Button.Danger"
                android:text="@string/screen_action_btnconfirmleaveteam" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
