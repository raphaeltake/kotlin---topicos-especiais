<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    tools:context=".PasswordActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/auth_hero_height"
        android:background="@drawable/bg_auth_hero"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/passwordRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="32dp">

            <ImageButton
                android:id="@+id/backButton"
                style="@style/Screen.IconButton.Glass"
                android:layout_gravity="start"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back" />

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_logo_tile"
                android:elevation="10dp">

                <ImageView
                    android:id="@+id/passwordLogo"
                    android:layout_width="62dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/logo" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="-0.02"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/app_tagline"
                android:textColor="@color/white_85"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:background="@drawable/bg_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    style="@style/Screen.Title"
                    android:text="@string/auth_password_title" />

                <!-- Conta selecionada na etapa anterior. -->
                <LinearLayout
                    android:id="@+id/accountInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_soft"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        style="@style/Screen.IconTile"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_team_member" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/loggingInAsLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/logging_in_as"
                            android:textColor="@color/gray"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/selectedEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            tools:text="email@email.com" />
                    </LinearLayout>
                </LinearLayout>

                <br.com.fatec.syncro.ui.SyncroTextInput
                    android:id="@+id/passwordInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="@string/password_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    app:endIconContentDescription="@string/toggle_password_visibility"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_lock" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/passwordLoginButton"
                    style="@style/Screen.Button.Primary"
                    android:layout_marginTop="20dp"
                    android:text="@string/login" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
