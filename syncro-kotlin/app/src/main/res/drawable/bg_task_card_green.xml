<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Camada de fundo (Cor do Status) -->
    <item>
        <shape>
            <solid android:color="@color/status_green" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Camada superior (Branca) com recuo à esquerda -->
    <!-- O raio menor (12dp) no lado esquerdo interno ajuda a manter a espessura da borda constante na curva -->
    <item android:left="4dp">
        <shape>
            <solid android:color="@color/white" />
            <corners
                android:topLeftRadius="12dp"
                android:bottomLeftRadius="12dp"
                android:topRightRadius="16dp"
                android:bottomRightRadius="16dp" />
            <stroke android:width="1dp" android:color="#F1F5F9" />
        </shape>
    </item>
</layer-list>
