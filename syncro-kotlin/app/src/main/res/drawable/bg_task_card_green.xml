<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_dark">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="@color/white" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_card" />
    <!-- Barra arredondada indicando o status da tarefa. -->
    <item
        android:width="4dp"
        android:gravity="start|fill_vertical"
        android:bottom="18dp"
        android:start="12dp"
        android:top="18dp">
        <shape>
            <solid android:color="@color/status_green" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</ripple>
